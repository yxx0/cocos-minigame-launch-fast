{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "game-minigame-launch-fast",
    "version": "1.0.0",
    "author": "yxx0",
    "editor": ">=3.0.0",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "npx tsc"
    },
    "description": "Cocos Creator 游戏首屏渲染插件 适用于3.x版本",
    "main": "./dist/main.js",
    "dependencies": {
        "fs-extra": "^10.0.0",
        "vue": "^3.1.4"
    },
    "devDependencies": {
        "@cocos/creator-types": "^3.8.7",
        "@types/fs-extra": "^9.0.5",
        "@types/node": "^18.17.1",
        "typescript": "^5.9.3"
    },
    "panels": {
        "default": {
            "title": "配置面板",
            "type": "dockable",
            "main": "dist/panels/default",
            "size": {
                "min-width": 400,
                "min-height": 300,
                "width": 1024,
                "height": 600
            }
        }
    },
    "contributions": {
        "menu": [
            {
                "path": "扩展/game-minigame-launch-fast",
                "label": "修改配置",
                "message": "open-panel"
            }
        ],
        "messages": {
            "open-panel": {
                "methods": [
                    "openPanel"
                ]
            }
        },
        "builder": "./dist/builder.js"
    }
}